# Expo SDK 51 expects a flat node_modules: babel-preset-expo injects @babel/runtime imports
# into app code, which pnpm's isolated layout does not let apps/mobile resolve.
node-linker=hoisted

# This project's own package store outside OneDrive, shared with no other project. pnpm
# hard-links store files into node_modules, and OneDrive turns synced files into cloud
# placeholders that Metro cannot read ("Unable to resolve ./types"), which corrupts every
# project sharing that store.
store-dir=../.pnpm-store-3sheerti
